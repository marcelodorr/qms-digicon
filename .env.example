# Copie para .env (uso local com docker) ou configure estas variáveis
# diretamente no painel de "Environment" do serviço no Dokploy.

# Connection string do PostgreSQL já existente na VPS.
# Formato Npgsql: Host=...;Port=5432;Database=...;Username=...;Password=...
ConnectionStrings__DefaultConnection=Host=SEU_HOST;Port=5432;Database=dbqms;Username=SEU_USUARIO;Password=SUA_SENHA

# Porta em que o container escuta (o Dockerfile já expõe 8080)
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Production
